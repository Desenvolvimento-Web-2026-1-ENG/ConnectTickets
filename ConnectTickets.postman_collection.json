            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Lucas Oliveira Postman\",\n  \"email\": \"lucas.postman.novo@empresa.com\",\n  \"perfil\": \"CLIENTE\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/v1/usuarios",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "v1", "usuarios"]
            }
          }
        }
      ]
